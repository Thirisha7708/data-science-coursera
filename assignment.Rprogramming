# =========================
# STEP 1: LOAD DATA
# =========================

data <- read.table("household_power_consumption.txt",
                   header = TRUE,
                   sep = ";",
                   na.strings = "?",
                   stringsAsFactors = FALSE)

# =========================
# STEP 2: CONVERT DATE
# =========================

data$Date <- as.Date(data$Date, format = "%d/%m/%Y")

# =========================
# STEP 3: SUBSET DATA
# (Feb 1 and Feb 2, 2007)
# =========================

subset_data <- data[data$Date >= "2007-02-01" &
                      data$Date <= "2007-02-02", ]

# =========================
# STEP 4: CREATE DATETIME
# =========================

subset_data$Datetime <- as.POSIXct(paste(subset_data$Date,
                                         subset_data$Time))

# =========================
# STEP 5: PLOT 1
# =========================

plot(subset_data$Datetime,
     subset_data$Global_active_power,
     type = "l",
     xlab = "",
     ylab = "Global Active Power")

# =========================
# STEP 6: PLOT 2
# =========================

plot(subset_data$Datetime,
     subset_data$Voltage,
     type = "l",
     xlab = "datetime",
     ylab = "Voltage")

# =========================
# STEP 7: PLOT 3
# =========================

plot(subset_data$Datetime,
     subset_data$Sub_metering_1,
     type = "l",
     xlab = "",
     ylab = "Energy sub metering")

lines(subset_data$Datetime,
      subset_data$Sub_metering_2,
      col = "red")

lines(subset_data$Datetime,
      subset_data$Sub_metering_3,
      col = "blue")

legend("topright",
       legend = c("Sub_metering_1",
                  "Sub_metering_2",
                  "Sub_metering_3"),
       col = c("black", "red", "blue"),
       lty = 1)

# =========================
# STEP 8: PLOT 4
# =========================

par(mfrow = c(2,2))

plot(subset_data$Datetime,
     subset_data$Global_active_power,
     type = "l")

plot(subset_data$Datetime,
     subset_data$Voltage,
     type = "l")

plot(subset_data$Datetime,
     subset_data$Sub_metering_1,
     type = "l")

plot(subset_data$Datetime,
     subset_data$Global_reactive_power,
     type = "l")